NODE_ENV=development
PORT=4000

# TiDB (MySQL 8.0 wire-compatible).
#
# Local development — docker compose up -d tidb:
DATABASE_URL="mysql://root@localhost:4100/sva_erp"
#
# TiDB Cloud Serverless — copy the connection string from the console and append
# sslaccept=strict. TiDB Cloud requires TLS.
# DATABASE_URL="mysql://<user>:<password>@<host>:4000/sva_erp?sslaccept=strict"
#
# Create the schema with a case-insensitive collation so that searching for
# "phenyl" also finds "Phenyl":
#   CREATE DATABASE sva_erp CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-64-character-random-string
REFRESH_TOKEN_SECRET=replace-me-with-a-different-64-character-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=debug
STORAGE_DIR=./storage
PUBLIC_BASE_URL=http://localhost:4000

# Optional: enables automatic Google review import (with a Place ID in settings)
# GOOGLE_PLACES_API_KEY=
